{
  "name": "newssummarizer",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-navigation/bottom-tabs": "^7.18.17",
    "@react-navigation/native": "^7.3.17",
    "@react-navigation/native-stack": "^7.18.9",
    "@supabase/supabase-js": "^2.117.2",
    "cors": "^2.8.6",
    "expo": "~54.0.0",
    "expo-apple-authentication": "~8.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-speech": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-video": "~3.0.16",
    "express": "^5.2.1",
    "firebase": "^12.19.0",
    "hls.js": "^1.7.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-purchases": "^10.11.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "undici": "^6.29.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "~19.1.0",
    "sharp": "^0.35.3",
    "typescript": "^5.3.3"
  },
  "scripts": {
    "start": "node scripts/dev.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "proxy": "node server/proxy.js",
    "build:android": "expo prebuild -p android && cd android && gradlew.bat assembleRelease",
    "build:ios": "expo prebuild -p ios && cd ios && pod install && xcodebuild -workspace NewsSummarizer.xcworkspace -scheme NewsSummarizer -configuration Release",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "release:check": "node scripts/check-release.cjs",
    "release:check:ios": "node scripts/check-release.cjs --platform=ios",
    "release:check:android": "node scripts/check-release.cjs --platform=android",
    "build:store:android": "npx eas-cli build --platform android --profile production",
    "build:store:ios": "npx eas-cli build --platform ios --profile production",
    "submit:store:android": "npx eas-cli submit --platform android --profile production",
    "submit:store:ios": "npx eas-cli submit --platform ios --profile production",
    "public:config": "node scripts/build-public-config.cjs",
    "supabase:deploy:delete-account": "node scripts/deploy-supabase-delete-account.cjs",
    "export:web:release": "npm run public:config && expo export --platform web --output-dir dist-web && node scripts/copy-public.cjs dist-web"
  },
  "private": true
}
