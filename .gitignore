!/server/tls-extra-ca.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# test / local design output
test-results/
design-review/
dist-auth-store/
dist-web-check/
dist-web/
dist-android-check/
package.json.*
!package.json

# Edge TTS MP3 disk cache (server/proxy.js)
server/.tts-cache/

# local env
.env

# firebase cli local state
.firebase/
firebase-debug.log

# Kilo agent local state
.kilo/
