# Production proxy/API. Do not ship localhost in a store build.
EXPO_PUBLIC_PROXY_URL=https://api.example.com

# Authentication provider: firebase (default) or supabase.
# Use supabase only with a live project URL/key. Existing Supabase users must be
# imported into Firebase before switching a shipped app to firebase.
EXPO_PUBLIC_AUTH_PROVIDER=firebase

# Firebase Authentication: Firebase Console -> Project settings -> Your apps -> Web app.
# This is PUBLIC Web App config, not a service account JSON / admin private key.
EXPO_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
EXPO_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_WEB_APP_ID

# Social sign-in (Firebase):
# - Google web works through Firebase's popup once Google is enabled in Firebase.
# - Google native uses @react-native-google-signin/google-signin. Create OAuth
#   clients in Google Cloud Console (Web, iOS, Android) and fill the IDs below.
#   Android needs the release SHA-1 and package com.autoship.newssummarizer.
# - Apple is disabled. To re-enable it, see FIREBASE_AUTH_SETUP.md and set
#   EXPO_PUBLIC_APPLE_SIGN_IN_ENABLED=true after restoring the Apple capability.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=YOUR_IOS_CLIENT_ID.apps.googleusercontent.com
# Optional: derived from EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID by the config plugin.
# EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.YOUR_IOS_CLIENT_ID
EXPO_PUBLIC_APPLE_SIGN_IN_ENABLED=false

# Supabase Auth (alternate provider; public client values only — NEVER put
# service-role keys in the app).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
EXPO_PUBLIC_AUTH_REDIRECT_URL=newssummarizer://auth/callback
EXPO_PUBLIC_PASSWORD_RESET_URL=newssummarizer://auth/reset

# RevenueCat public SDK keys. Create one app for iOS and one for Android.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_XXXXXXXXXXXXXX
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_XXXXXXXXXXXXXX
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=plus

# Public legal pages required before store submission.
EXPO_PUBLIC_PRIVACY_URL=https://app.example.com/privacy.html
EXPO_PUBLIC_TERMS_URL=https://app.example.com/terms.html
EXPO_PUBLIC_SUPPORT_URL=https://app.example.com/support.html

# Store/public support and deletion page.
EXPO_PUBLIC_SUPPORT_EMAIL=you@example.com
EXPO_PUBLIC_DELETE_ACCOUNT_URL=https://app.example.com/delete-account.html
